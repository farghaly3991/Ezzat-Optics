{
  "name": "multi-tenant-store-server",
  "version": "1.0.0",
  "description": "Multi-Tenant E-Commerce Server with Twin-Engine AI/Standard Architecture",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seed.js",
    "test": "npm run test:analytics && npm run test:ai-instructions && npm run test:finance && npm run test:product-requests && npm run test:returns && npm run test:cart-notifications && npm run test:market-intel",
    "test:analytics": "node tests/phase1_analytics.test.js",
    "test:ai-instructions": "node tests/phase2_ai_instructions.test.js",
    "test:finance": "node modules/finance/tests/finance_phase_ab.test.js && node modules/finance/tests/finance_phase_cdef.test.js",
    "test:product-requests": "node tests/phase3_product_requests.test.js",
    "test:returns": "node tests/phase4_returns_warranty.test.js",
    "test:cart-notifications": "node tests/phase5_cart_notifications.test.js",
    "test:market-intel": "node tests/phase6_market_intel.test.js",
    "test:semantic-engine": "node tests/test_unified_semantic_engine.js",
    "test:hossam-e2e": "node tests/test_hossam_e2e_simulation.js"
  },
  "dependencies": {
    "aws-sdk": "^2.1693.0",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fs-extra": "^11.2.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.13.0",
    "mongoose": "^8.9.2",
    "multer": "^1.4.5-lts.1",
    "multer-s3": "^3.0.1",
    "pdf-parse": "^2.4.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
